// Purslane Notes visual tuning
body
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif
  letter-spacing: .01em

.post-meta
  font-size: .84em
  line-height: 1.45

.post-meta .post-meta-item-icon
  font-size: .9em

.post-button .btn
  font-size: .9em
  padding: .45em 1.1em

.symbols-count
  font-size: .78em
  opacity: .72

.post-body
  font-size: 1em
  line-height: 1.85

.post-body h1,
.post-body h2,
.post-body h3
  letter-spacing: -.015em

.category-all-page .category-list,
.tag-cloud
  font-size: .92em

.menu-item a
  font-size: .94em
